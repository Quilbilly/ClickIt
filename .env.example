# ClickIt local / production config
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787

# mock | sony
CAMERA_PROVIDER=mock
SONY_SIDECAR_URL=http://127.0.0.1:8791
SONY_BRIDGE_PORT=8791

# local | s3  (s3 also covers Cloudflare R2)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# json (log/dev) | smtp
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClickIt <noreply@example.com>"

# Comma-separated admin token(s) for /api/admin/*
ADMIN_TOKENS=dev-admin-token

DOWNLOAD_LINK_HOURS=168
QUEUE_POLL_MS=5000

# Electron kiosk
KIOSK_FULLSCREEN=true
KIOSK_FRAME=false

DEFAULT_COUNTDOWN_SECONDS=3
DEFAULT_PHOTO_COUNT=3
DEFAULT_INTERVAL_MS=1500
EVENT_NAME=ClickIt Event
