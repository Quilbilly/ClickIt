{
  "name": "clickit",
  "version": "0.2.0",
  "private": true,
  "description": "ClickIt — tethered photo booth for Sony ILCE-7RM5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --config nodemon.json server/index.js",
    "booth": "node server/index.js",
    "sony-bridge": "node sidecars/sony-bridge/launch.js",
    "sony-bridge:dev": "node sidecars/sony-bridge/server.js",
    "sony-bridge:build": "node sidecars/sony-bridge/native/scripts/build-npm.js",
    "sony-bridge:stage-runtime": "node sidecars/sony-bridge/native/scripts/stage-runtime.js",
    "sony-bridge:verify-dist": "node sidecars/sony-bridge/native/scripts/verify-dist.js",
    "sony-bridge:doctor": "node sidecars/sony-bridge/native/scripts/doctor.js",
    "dev:sony": "concurrently -k \"npm:sony-bridge\" \"npm:dev\"",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:8787/api/health && electron .\"",
    "kiosk": "KIOSK_FULLSCREEN=true electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.0",
    "nodemailer": "^6.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "nodemon": "^3.1.9",
    "wait-on": "^8.0.5"
  }
}
